<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>localization</name>
  <version>0.0.0</version>
  <description>EKF sensor fusion and slam_toolbox mapping/localization for Modysseus. (No AprilTag pose correction: see perception/launch/apriltag.launch.py for why that was never wired up.)</description>
  <maintainer email="albin@stenboda.se">Albin</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>robot_localization</depend>
  <depend>slam_toolbox</depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <!-- NOT declared: a dependency on `perception`, even though
       mapping_mission.launch.py includes its apriltag.launch.py. perception
       already exec_depends on localization (its docking.launch.py runs
       `ros2 run localization slam_lifecycle_watchdog.py`), so the reverse edge
       would be a circular dependency colcon refuses to order. Both packages
       live in this one workspace, so the include resolves at runtime; a
       missing perception is reported by launch as a plain
       PackageNotFoundError.
       mapping_mission.launch.py also tells the operator to run
       teleop_twist_keyboard, which is a separate process in its own terminal
       and not launched from here, hence not a dependency either. -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
