<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>localization</name>
  <version>0.0.0</version>
  <description>EKF sensor fusion and slam_toolbox mapping/localization for Modysseus. (No AprilTag pose correction: see perception/launch/apriltag.launch.py for why that was never wired up.)</description>
  <maintainer email="albin@stenboda.se">Albin</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <!-- Installs localization/ as an importable Python package (see CMakeLists.txt). -->
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <depend>robot_localization</depend>
  <depend>slam_toolbox</depend>
  <exec_depend>laser_filters</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <!-- wheel_odometry_node.py: consumes JointState, publishes Odometry and
       broadcasts TransformStamped via tf2_ros. numpy is only for its constant
       covariance arrays. -->
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <!-- Not declared: a dependency on `perception`, though
       mapping_mission_hardware.launch.py includes its apriltag.launch.py.
       perception already depends on localization (docking.launch.py runs
       slam_lifecycle_watchdog.py), so the reverse edge would be a cycle. Both
       live in this workspace, so the include resolves at runtime; if perception
       is missing, launch reports PackageNotFoundError. teleop_twist_keyboard is
       likewise a separate process and not a dependency. -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
