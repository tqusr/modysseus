<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>localization</name>
  <version>0.0.0</version>
  <description>EKF sensor fusion and slam_toolbox mapping/localization for Modysseus. (No AprilTag pose correction: see perception/launch/apriltag.launch.py for why that was never wired up.)</description>
  <maintainer email="albin@stenboda.se">Albin</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>robot_localization</depend>
  <depend>slam_toolbox</depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
