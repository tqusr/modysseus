<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>navigation</name>
  <version>0.0.0</version>
  <description>Nav2 stack (costmaps, planner, MPPI controller, velocity smoother, collision monitor, bt_navigator) for Modysseus. Consumes slam_toolbox's map-&gt;odom (no AMCL) and produces the real NavigateToPose action.</description>
  <maintainer email="albin@stenboda.se">Albin</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>nav2_bringup</depend>
  <depend>nav2_common</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>nav2_controller</depend>
  <depend>nav2_planner</depend>
  <depend>nav2_navfn_planner</depend>
  <depend>nav2_mppi_controller</depend>
  <depend>nav2_rotation_shim_controller</depend>
  <depend>nav2_behaviors</depend>
  <depend>nav2_bt_navigator</depend>
  <depend>nav2_velocity_smoother</depend>
  <depend>nav2_collision_monitor</depend>
  <depend>nav2_lifecycle_manager</depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
