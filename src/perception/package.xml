<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>perception</name>
  <version>0.0.0</version>
  <description>AprilTag detection and docking server bring-up for Modysseus.</description>
  <maintainer email="albin@stenboda.se">Albin</maintainer>
  <license>Apache-2.0</license>

  <!-- ament_python: nothing is compiled, and launch/ and config/ install via
       setup.py's data_files. -->
  <depend>apriltag_ros</depend>
  <depend>opennav_docking</depend>
  <depend>pcl_ros</depend>

  <!-- capture_dock_pose's runtime dependencies. -->
  <depend>rclpy</depend>
  <depend>tf2_ros</depend>
  <depend>apriltag_msgs</depend>
  <!-- tag_dock_server's, in addition. -->
  <depend>nav2_msgs</depend>
  <depend>action_msgs</depend>
  <depend>geometry_msgs</depend>
  <exec_depend>python3-yaml</exec_depend>

  <exec_depend>localization</exec_depend>
  <!-- apriltag.launch.py starts image_proc's rectify_node (rectify:=true).
       apriltag_ros usually pulls it in; declared because our launch names it. -->
  <exec_depend>image_proc</exec_depend>
  <!-- Not declared: a dependency on `mission`, though capture_dock_pose rewrites
       mission/config/docks.yaml. It finds the file by walking up to the
       workspace source tree from this package's share directory, never through
       mission's share directory or Python package, because mission already
       depends on perception (mission.launch.py includes our launch files) and
       the reverse edge would be a cycle. -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
